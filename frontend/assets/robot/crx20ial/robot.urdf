<?xml version="1.0"?>
<robot name="crx20ia_l_web">
  <link name="world" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="meshes/crx20ial/visual/base.dae" /></geometry>
    </visual>
  </link>

  <link name="J1_link">
    <visual>
      <origin xyz="0 0 -0.245" rpy="0 0 0" />
      <geometry><mesh filename="meshes/crx20ial/visual/j1.dae" /></geometry>
    </visual>
  </link>

  <link name="J2_link">
    <visual>
      <origin xyz="0 0 -0.245" rpy="0 0 0" />
      <geometry><mesh filename="meshes/crx20ial/visual/j2.dae" /></geometry>
    </visual>
  </link>

  <link name="J3_link">
    <visual>
      <origin xyz="0 0 -0.955" rpy="0 0 0" />
      <geometry><mesh filename="meshes/crx20ial/visual/j3.dae" /></geometry>
    </visual>
  </link>

  <link name="J4_link">
    <visual>
      <origin xyz="0 0 -0.955" rpy="0 0 0" />
      <geometry><mesh filename="meshes/crx20ial/visual/j4.dae" /></geometry>
    </visual>
  </link>

  <link name="J5_link">
    <visual>
      <origin xyz="-0.540 0 -0.955" rpy="0 0 0" />
      <geometry><mesh filename="meshes/crx20ial/visual/j5.dae" /></geometry>
    </visual>
  </link>

  <link name="J6_link">
    <visual>
      <origin xyz="-0.540 0.150 -0.955" rpy="0 0 0" />
      <geometry><mesh filename="meshes/crx20ial/visual/j6.dae" /></geometry>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.75" rpy="0 0 0" />
    <parent link="world" />
    <child link="base_link" />
  </joint>

  <!-- 定义名为 J1 的旋转关节 (revolute) -->
  <joint name="J1" type="revolute">
    <!-- 关节坐标原点相对于父连杆的位置（Z轴上方 0.245米），并且没有姿态旋转 -->
    <origin xyz="0 0 0.245" rpy="0 0 0" />
    <!-- 指定父连杆为底座 base_link -->
    <parent link="base_link" />
    <!-- 指定子连杆为被驱动的 J1_link -->
    <child link="J1_link" />
    <!-- 定义关节是围绕自身的 Z 轴旋转的 -->
    <axis xyz="0 0 1" />
    <!-- 定义关节的物理限制：旋转角度范围(-3.14到3.14弧度，约-180到180度)，最大力矩750牛米，最大速度1.39弧度/秒 -->
    <limit lower="-3.139847" upper="3.139847" effort="750" velocity="1.396263" />
  </joint>

  <joint name="J2" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="J1_link" />
    <child link="J2_link" />
    <axis xyz="0 1 0" />
    <limit lower="-3.139847" upper="3.139847" effort="750" velocity="1.396263" />
  </joint>

  <joint name="J3" type="revolute">
    <origin xyz="0 0 0.710" rpy="0 0 0" />
    <parent link="J2_link" />
    <child link="J3_link" />
    <axis xyz="0 -1 0" />
    <limit lower="-4.712389" upper="4.712389" effort="350" velocity="2.094395" />
  </joint>

  <joint name="J4" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="J3_link" />
    <child link="J4_link" />
    <axis xyz="-1 0 0" />
    <limit lower="-3.316126" upper="3.316126" effort="150" velocity="1.963495" />
  </joint>

  <joint name="J5" type="revolute">
    <origin xyz="0.540 0 0" rpy="0 0 0" />
    <parent link="J4_link" />
    <child link="J5_link" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.139847" upper="3.139847" effort="110" velocity="1.570796" />
  </joint>

  <joint name="J6" type="revolute">
    <origin xyz="0 -0.150 0" rpy="0 0 0" />
    <parent link="J5_link" />
    <child link="J6_link" />
    <axis xyz="-1 0 0" />
    <limit lower="-3.926991" upper="3.926991" effort="110" velocity="1.963495" />
  </joint>

  <link name="flange" />
  <joint name="J6-flange" type="fixed">
    <origin xyz="0.160 0 0" rpy="0 0 0" />
    <parent link="J6_link" />
    <child link="flange" />
  </joint>

  <link name="ee_link" />
  <joint name="child_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="flange" />
    <child link="ee_link" />
  </joint>
</robot>
